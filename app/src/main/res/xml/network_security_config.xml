<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- De nombreux flux IPTV publics sont encore servis en HTTP clair -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
